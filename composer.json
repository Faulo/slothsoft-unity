{
    "name": "slothsoft/unity",
    "description": "Slothsoft's Unity API",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "type": "library",
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-xsl": "*",
        "slothsoft/core": "^1.14.28",
        "slothsoft/schema": "^1.7.3",
        "symfony/process": "^5.4.51",
        "symfony/filesystem": "^5.4.45",
        "mustangostang/spyc": "^0.6.3",
        "mintopia/vdfkeyvalue": "^1.0.1",
        "symfony/dom-crawler": "^5.4.52",
        "symfony/browser-kit": "^5.4.45",
        "symfony/http-client": "^5.4.53",
        "symfony/mime": "^5.4.52",
        "vlucas/phpdotenv": "^5.7.0",
        "php-imap/php-imap": "^5.1.0",
        "symfony/console": "^6.4.47",
        "symfony/string": "^7.4.19"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.2",
        "phpunit/phpunit": "~9.6.34",
        "slothsoft/farah-testing": "^1.3.3"
    },
    "autoload": {
        "psr-4": {
            "Slothsoft\\Unity\\": "src"
        },
        "files": [
            "src/bootstrap.php"
        ]
    },
    "keywords": [
        "slothsoft",
        "docs",
        "unity"
    ],
    "autoload-dev": {
        "psr-4": {
            "Slothsoft\\Unity\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.22.x-dev"
        }
    },
    "bin": [
        "scripts/autoversion",
        "scripts/steam-buildfile",
        "scripts/steam-login",
        "scripts/unity-command",
        "scripts/unity-build",
        "scripts/unity-documentation",
        "scripts/unity-help",
        "scripts/unity-method",
        "scripts/unity-start",
        "scripts/unity-module-install",
        "scripts/unity-empty-project",
        "scripts/unity-package-install",
        "scripts/unity-project-setting",
        "scripts/unity-project-version",
        "scripts/unity-tests",
        "scripts/transform-dotnet-format"
    ],
    "config": {
        "process-timeout": 0,
        "bin-compat": "full",
        "platform": {
            "php": "8.2"
        }
    },
    "homepage": "https://faulo.github.io/slothsoft-unity/"
}
